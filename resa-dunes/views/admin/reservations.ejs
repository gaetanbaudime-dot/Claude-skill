<%- include('tete') %>

<h1>Réservations</h1>

<form method="get" action="/admin/reservations" class="barre-filtres">
  <label>Du <input type="date" name="du" value="<%= filtres.du %>"></label>
  <label>Au <input type="date" name="au" value="<%= filtres.au %>"></label>
  <label>Statut
    <select name="statut">
      <option value="">Tous</option>
      <option value="confirmee" <%= filtres.statut === 'confirmee' ? 'selected' : '' %>>Confirmée</option>
      <option value="arrivee" <%= filtres.statut === 'arrivee' ? 'selected' : '' %>>Arrivée</option>
      <option value="no_show" <%= filtres.statut === 'no_show' ? 'selected' : '' %>>No-show</option>
      <option value="annulee" <%= filtres.statut === 'annulee' ? 'selected' : '' %>>Annulée</option>
    </select>
  </label>
  <label>Recherche <input type="text" name="q" value="<%= filtres.q %>" placeholder="nom ou téléphone"></label>
  <button class="btn btn-petit">Filtrer</button>
  <a class="btn btn-ligne btn-petit" href="/admin/export/reservations.csv">Export CSV</a>
</form>

<table class="tableau">
  <thead><tr><th>Date</th><th>Service</th><th>Heure</th><th>Nom</th><th>Tél.</th><th>Couv.</th><th>Statut</th><th>Source</th></tr></thead>
  <tbody>
  <% for (const r of resas) { %>
    <tr class="ligne-<%= r.statut %>">
      <td><a href="/admin?date=<%= r.date %>"><%= r.date %></a></td>
      <td><%= r.service %></td>
      <td><%= r.heure %></td>
      <td><a href="/admin/clients/<%= r.client_id %>"><%= r.client_nom %></a></td>
      <td><%= r.client_tel %></td>
      <td><%= r.couverts %></td>
      <td><span class="pastille pastille-<%= r.statut %>"><%= r.statut %></span></td>
      <td><%= r.source %></td>
    </tr>
  <% } %>
  <% if (resas.length === 0) { %><tr><td colspan="8" class="discret">Rien sur cette période.</td></tr><% } %>
  </tbody>
</table>

<%- include('pied') %>

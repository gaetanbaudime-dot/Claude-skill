# Copie ce fichier en `.env` puis remplis les valeurs. Ne JAMAIS commiter le .env.

# ---- Bot DISCORD (le bot principal — bot_discord.py) ----

# Token du bot Discord (Developer Portal → ton application → Bot → Reset Token)
DISCORD_TOKEN=

# Clé API Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# ID de l'ancien canal de l'assistant. Depuis le 27/09 le bot n'y répond plus (les questions vont dans le
# salon perso de chaque clipper) ; il sert de repli au salon admin quand CANAL_ADMIN_ID est vide.
CANAL_BOT_ID=

# Ton (tes) identifiant(s) Discord, pour les commandes !stats et !apprendre.
# Clic droit sur ton profil → Copier l'identifiant. Plusieurs admins séparés par des virgules.
ADMIN_IDS=

# Optionnel — modèle. Par défaut claude-haiku-4-5 (rapide, ~gratuit, largement assez pour la FAQ).
# MODELE=claude-opus-4-8   # décommente pour des réponses plus fines (5x plus cher)

# Optionnel — questions max par clipper et par jour (30 par défaut)
# QUESTIONS_MAX_PAR_JOUR=30

# Dossier des données persistantes (compteur public, paiements, FAQ apprise, quotas).
# En local : laisser vide (utilise ./donnees). Sur Railway : DONNEES_DIR=/data + un VOLUME monté
# sur /data — ⚠️ sans ça, TOUS les compteurs sont remis à zéro à chaque déploiement (vécu le 17/07).
# DONNEES_DIR=

# ---- v2 : programme clippers (compteur, paiements, invitations, rangs) ----

# Canal des paiements/wins (#dopamine) : le bot y poste les !paiement et y épingle
# le compteur « X € versés ». Clic droit sur le canal → Copier l'identifiant.
CANAL_DOPAMINE_ID=

# Canal d'accueil des candidats (#candidature) : bienvenue numérotée + attribution du parrain.
CANAL_CANDIDATURE_ID=

# Lien du formulaire de candidature (mis dans le message de bienvenue).
LIEN_FORMULAIRE=

# ⚠️ ACTIVER_V2=1 allume le tracking d'invitations + l'accueil automatique.
# AVANT de le mettre à 1 : Developer Portal → Bot → activer « SERVER MEMBERS INTENT »,
# et donner au bot la permission « Gérer le serveur » (lecture des invitations).
# Sans ces deux prérequis, le bot NE DÉMARRE PAS avec ACTIVER_V2=1.
# ACTIVER_V2=1

# ---- Salons-compteurs (titres auto, comme House of Aphrodite mais vrais chiffres) ----
# Crée une catégorie verrouillée « STATS » avec des salons VOCAUX (personne ne peut s'y connecter) ;
# le bot renomme leur TITRE toutes les 10 min. Permission requise : « Gérer les salons ».
# ID du salon « 💸 Déjà payés : X € » (alimenté par les !paiement) :
CANAL_STAT_PAYES_ID=
# ID du salon « 🎬 Clippers : N ». 11/10 (lot W) : À RETIRER de Railway (et le salon à supprimer) : plus rien ne le rafraîchit
# tout seul (boucle des compteurs supprimée), il afficherait un chiffre faux. `!actifs` donne le vrai chiffre.
# CANAL_STAT_CLIPPERS_ID=
# Nom du/des rôle(s) d'équipe reconnus (purge des candidats, rangs), séparés par des virgules :
# ROLE_CLIPPER_NOM=Rookie,Confirmé,Élite

# ---- Rôles d'équipe (attribution à la signature du contrat UNIQUEMENT, via !equipe) ----
# Ces rôles ouvrent les salons rémunération/discussion par pays : ils ne doivent JAMAIS être
# distribués par l'onboarding Discord ni auto-attribuables (incident du 18/07).
# ROLE_TEAM_FR_NOM=Team France
# ROLE_TEAM_MG_NOM=Team Madagascar

# ---- Pipeline candidat ----
# 09/10 : plus de test de montage. LIEN_TEST, TEST_* et RELANCE_NOUVEAUX=1 sont retirés (README, « 09/10 : le funnel simplifié ») :
# à supprimer aussi dans Railway APRÈS une journée sans incident.
# LIEN_QUIZ (lien pré-rempli du Google Form « Quiz ») : retiré le 09/10, plus lu par le bot (le quizz est sur le site). À retirer de
# Railway avec les autres, ci-dessous.
# ID du salon #assistant (clic droit sur le salon → Copier l'identifiant) : réparé ou créé par le bot s'il manque (05/10).
CANAL_ASSISTANT_ID=
# ID du forum « formation » (clic droit → Copier l'identifiant) : lié dans le MP d'étape 2
# (après le numéro, le bot envoie « va dans <#formation> » + le lien de quiz personnel).
CANAL_FORMATION_ID=
# Posts du forum formation, un identifiant PAR POST (clic droit sur chaque post → Copier l'identifiant).
# L'assistant IA cite alors la BONNE fiche en lien cliquable, et l'étape 2 du parcours pointe
# directement sur le post Bienvenue. Format :
# POSTS_FORMATION=bienvenue:111,1:222,2:333,3:444,4:555,5:666,6:777,kit:888
POSTS_FORMATION=
# Liaison d'identité (v5, 18/07) — aucune variable à poser : l'Apps Script de la feuille de
# candidatures poste « CANDIDATURE|prénom|tel|pays|pseudo » sur le MÊME webhook Discord que le
# quiz (salon admin). Le bot indexe la fiche par téléphone normalisé ; !lier la relie au membre,
# le renomme avec son prénom, et !equipe sans mot d'équipe choisit FR/International d'après le pays.
# Portes d'entrée (qui arrive d'où) : crée UNE invitation permanente par canal (Serveur →
# Invitations → expire : jamais, usages : illimités) et n'utilise chaque lien QU'À UN ENDROIT :
# celle « formulaire » vit uniquement dans le message de confirmation du Google Forms, celle
# « disboard » uniquement dans les réglages disboard.org, etc. Puis déclare-les ici :
# SOURCES_INVITES=aBcD123:formulaire,xYz789:disboard,qRs456:indeed   (code = fin de discord.gg/CODE)
# L'accueil s'adapte (formulaire → « relie ta candidature » ; sinon → deux branches), la porte
# apparaît dans !fiche et !pipeline. Une invitation étiquetée ne crédite JAMAIS le parrainage.
SOURCES_INVITES=

# ---- Salon admin privé (19/07 — IMPORTANT) ----
# ID du salon PRIVÉ où partent les notifications sensibles : rendus de test, e-mails, contrats,
# sauvegardes, rattrapage des webhooks. À poser si CANAL_BOT_ID (le salon de l'assistant) est
# PUBLIC — sinon les rendus de test s'affichent devant tout le monde (vécu le 18/07 au soir).
# = l'ID de #bot-gaetan. Le webhook des Apps Script doit poster dans CE salon.
CANAL_ADMIN_ID=

# ---- Rôles de grille (19/07) : rémunération/bonus visibles dès la liaison ----
# Deux rôles à créer, qui n'ouvrent QUE les salons rémunération-xx et bonus-xx de leur grille
# (jamais les discussions — elles restent aux rôles Team). Attribués automatiquement à la
# liaison du numéro, grille déduite de l'indicatif ; jamais si pays et indicatif se contredisent.

# ---- Rappels récurrents (18/07) ----
# Lien de la sheet de suivi trésorerie : MP à l'admin chaque matin à 08:00 (heure de Paris).
LIEN_TRESORERIE=
# ID du salon #reporting : rappel automatique aux clippers le dimanche à 17:00 (avant minuit).
CANAL_REPORTING_ID=

# ---- Telegram : copie du point du matin et alertes de l'agence (telegram.py) ----
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=               # la conversation qui reçoit la copie et les alertes
# TELEGRAM_QUOTIDIEN=0             # 1 = copie du point du matin sur Telegram (0 par défaut : aucune copie)
# 11/10 (lot W) : CODE_ACCES (ancien bot.py, supprimé le 10/10) n'est plus lue : à retirer de Railway.

# ---- Bans Instagram vus par les mails de suspension (29/09) : même boîte que le relais des codes (CODES_IMAP_*) ----
# BANS_INTERVALLE_SEC=180        # un passage toutes les 3 minutes
# BANS_DEPLACER_SPAM=1           # les mails Meta IMPORTANTS du Spam sont remis dans la boîte de réception (0 pour laisser Gmail faire)
# BANS_PUB_VERS_SPAM=1           # la pub Meta (récaps, suggestions, qui vous suit) de la boîte de réception repart dans le Spam
# RESERVATION_JOURS=2            # 29/09 : une ligne réservée et jamais créée retourne au vivier après 48 h
# BANS_JOURS=3                   # les mails des 3 derniers jours sont regardés (les déjà traités sont retenus)
# 10/10 : un seul lecteur de la boîte (codes_2fa) ; BANS_IMAP_DOSSIERS n'est plus lue, à retirer de Railway.
# ---- Le classeur se vérifie seul après le scan (29/09) ----
# 11/10 : fondu dans le contrôle d'attribution (C13 à C16, Dashboard et salon admin), `!classeur` retiré ; mêmes variables
# CLASSEUR_SCANS_MIN=7           # C15 : « à créer » avec un Gérant jamais vu après 7 scans → signalé (moins de 7 lectures : « non mesuré »)
# CLASSEUR_MAX_COMPTES=3         # C16 : plus de 3 comptes vivants pour un clipper → signalé
# CONTROLE_STAFF=gaetan,rianah   # prénoms du staff jamais « Gérant fantôme » (C2) ; plus jonas depuis le 11/10 (parti le 09/10)
# ---- Salon commun des codes 2FA (29/09) ----
# CANAL_CODES_NOM=🔐-code-instagram   # créé par le bot s'il manque, réservé aux rôles ci-dessous et aux managers
# CODES_SALON_ROLES=Clippeur,Rookie,Confirmé,Elite
# CODES_SALON_MINUTES=60          # fenêtre de !code dans le salon commun
# CODES_IMAP_SPAM=[Gmail]/Spam    # le salon commun lit aussi le Spam
# ---- 10/10 : codes 2FA en liste blanche (connexion et création seulement) ----
# CODES_APPEL=0                   # le code d'un appel après un ban : gardé (0, défaut) ; 1 = le bouton le donne aussi
# CODES_SONDAGE_SEC=20            # le lecteur unique de la boîte : IDLE, sinon une lecture toutes les 20 s
# CODES_PREUVE_RELAIS=observer    # 1 = un mail relayé par iCloud sans la preuve de Meta est ignoré
# 10/10 : CODES_SALON_RECUP_MINUTES n'est plus lue (`!recup` ne donne plus rien) : à retirer de Railway.
# ---- Visites de la veille → groupe Telegram de chaque créatrice (03/10) ----
# VISITES_TELEGRAM_HEURE=9            # heure de Paris du message du matin
# VISITES_TELEGRAM_SUJET=📈 Visites de la veille
# VISITES_TELEGRAM_DECOUVERTE_SEC=300 # lecture des nouveaux groupes toutes les 5 minutes
# ---- 03/10 ----
# DOPAMINE_PREMIER_REEL=0         # « Bravo pour ton premier Reel » dans #dopamine : éteint (1 pour rallumer)

# ---- 09/10 : funnel simplifié (test de montage et Drive perso retirés) ----
# À RETIRER de Railway après une journée sans incident : LIEN_TEST, TEST_HEURES, TEST_SORTIE, TEST_AUTO, TEST_AUTO_SEUIL,
# TEST_TOUT_ACCEPTER, TEST_ESSAIS, DRIVE_AGENCE_URL, DRIVE_AGENCE_SECRET, COMPTES_UN_PAR_JOUR, REELS_UNIQUES_* (sauf
# REELS_UNIQUES_MAX), LIEN_QUIZ, OPUSCLIP_API_KEY, OPUSCLIP_TEMPLATE_ID, OPUSCLIP_ATTENTE_MAX (plus lues ; vérifier d'abord qu'aucun
# autre service Railway ne s'en sert). RELANCE_NOUVEAUX : à retirer (0 par défaut), surtout pas à 1.
# PARCOURS_STORY_AUTO_H=24        # une story à la une d'avant le 10/10 restée ouverte se ferme seule, avec la routine et l'app
# ATTRIBUTION_REPRISE_H=1         # un membre en attente d'une créatrice : au plus une reprise par heure
# ATTRIBUTION_PAUSE_SEC=90        # pause entre deux validations (migration, reprise)
# ---- 10/10 : places livrables, les deux goulots (lot L3) ----
# ATTRIBUTION_LIGNES_MIN=3        # lignes du classeur prises par un nouveau à son arrivée (son trio) ; ne la baisse pas avant
#                                 # d'avoir tranché le forfait GAML
# GAML_FORFAIT_LIENS=50           # liens actifs permis par le forfait GAML
# GAML_LISTE_MAX=100             # plafond supposé d'une réponse GAML (liens désactivés inclus) ; défaut : forfait + 50, au moins 100
# PLACES_GAML_ATTRIBUTION=0       # 1 = personne n'entre sans lien GAML possible pour son compte 3 (recommandé tant que le
#                                 # forfait de 50 n'est pas monté) ; 0 = le forfait limite `!annonce` et le point du matin seulement
# TELEPHONE2_ATTENTE_H=48         # 2e téléphone : son compte 1 au compte-goutte
# DRIVE_CREATRICE_TTL_SEC=21600   # le lien des vidéos d'origine de chaque créatrice, relu toutes les 6 h

# ---- 09/10 : Dashboard en continu et budget Apify ----
# Plafond de TOUS les appels Apify du mois, en dollars (décision de Gaëtan : « Dépasse pas 25 $ / mois »).
APIFY_BUDGET_MOIS=25
# APIFY_PRIX_1000=2.30            # prix des mille profils, si la dépense ne peut pas être lue sur l'API Apify
# ETATS_HEURES_LEGERES=14,20      # relectures légères d'Instagram (heures de Paris), sautées si le budget ne le permet pas
# CADENCE_AUTO : plus lue depuis le 11/10 (`!cadence` retirée, Reels et vues dans le Dashboard) — à retirer de Railway
# METRICOOL_API_KEY=
# METRICOOL_USER_ID=
# METRICOOL_HEURES=8,15           # Metricool relu deux fois par jour (données de la veille)

# ---- 10/10 et 11/10 : parcours sans attente (lot L1) ----
# PARCOURS_BIENVENUE_H=1          # filet : compte 1 au plus 1 h après la bienvenue (il part tout de suite) ; À RETIRER s'il vaut 3
# PARCOURS_TICK_MIN=10            # le programme du parcours relu toutes les 10 min (aucun appel Apify ni GAML)
# PARCOURS_LIGNE_REESSAI_MIN=30   # un compte qui attend une ligne libre : nouvel essai toutes les 30 min
# PARCOURS_PROFIL_AUTO_H=6        # le profil du privé oublié se ferme seul au bout de 6 h
# 11/10 : PARCOURS_ROUTINE2_JOURS n'est plus lue (plus de message à J+7) : à retirer de Railway.

# ---- 10/10 : un seul point du matin au salon admin (lot L9b) ----
# DIGEST=1                        # 0 = l'ancien découpage (bloqués à 11 h, sortie et appel à part)
# DIGEST_HEURE=9                  # heure de Paris au plus tôt (vers 10 h jusqu'au 24/10, après le scan ; 10 = la même heure toute l'année)
# DIGEST_HEURE_MAX=11             # au plus tard
# BLOQUES_ILLISIBLE_H=24          # un compte lu à 0 Reel 24 h après l'attente dite apparaît dans les bloqués
# PRENOMS_STAFF=gaetan            # prénoms jamais comptés comme clippers (pas « jonas »)

# ---- 10/10 : appel de présence (gardé, décision du 05/10) ----
# APPEL_MESURE_JOURS=1            # un relevé du scan plus vieux ne mesure plus rien : « non mesuré », jamais appelé ni sorti
# APPEL_MESURE_ATTENTE=7          # un appel échu sans mesure est clos sans sortie au bout de 7 jours
# APPEL_ILLISIBLE_ALERTE_H=6      # la mesure illisible depuis 6 h : une ligne « appel suspendu » au salon admin

# ---- 10/10 : équipes TL et managers (lot L10), primes sur la paie du 5 et du 20 ----
# Nombres à la française acceptés (« 0,25 », « 3 000 »). Une valeur illisible garde le défaut et le dit dans `!tl liste`.
# TL_PRIME_VA_USD=10              # prime du TL par VA de son équipe à TL_SEUIL_VA visites payées ou plus sur la quinzaine
# TL_SEUIL_VA=500
# MANAGER_PRIME_USD=75            # prime du manager par équipe à MANAGER_SEUIL_EQUIPE visites payées ou plus (TL exclu)
# MANAGER_SEUIL_EQUIPE=3000
# EQUIPE_COMPTE_TL=0              # 0 : le TL ne compte ni dans les 500 ni dans les 3 000 de son équipe (décision du 10/10)
# MANAGER_COMPTE=0                # 0 : les visites d'un manager qui clippe ne comptent pas dans les équipes qu'il manage
# PRIMES_EQUIPES_DEPUIS=2026-10-20  # 1re période primée : 20/10 → 04/11, payée le 05/11 ; vide = aucune prime
# PRIME_PREUVE_REELS=10           # moins de 10 Reels vus sur la quinzaine : prime « à vérifier »
# PRIME_ECART_NORME=0,25          # part de robots ou de visites non francophones anormale (écart de 25 points) : « à vérifier »
# PRIME_VOLUME_MIN=100            # en dessous, ni part ni Reels ne sont jugés
# ROLE_TL_NOM=Team Leader         # rôle sans aucune permission, créé par le bot
